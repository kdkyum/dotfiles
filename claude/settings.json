{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/upload-artifact-dropbox.sh",
            "timeout": 120,
            "statusMessage": "Uploading artifact to Dropbox..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-notify.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "research-tools@kdkyum-research-tools": true,
    "commit-commands@claude-plugins-official": false,
    "dbxcli@dbxcli": true,
    "frontend-design@anthropic-plugin-directory": true,
    "cc-plugin-telemetry@builtin": false,
    "pdf-viewer@synced": false
  },
  "extraKnownMarketplaces": {
    "kdkyum-research-tools": {
      "source": {
        "source": "github",
        "repo": "kdkyum/research-tools"
      }
    },
    "dbxcli": {
      "source": {
        "source": "github",
        "repo": "Dropbox/dbxcli"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "idleCompaction": false,
  "switchModelsOnFlag": true,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
