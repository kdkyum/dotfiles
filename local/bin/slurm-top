#!/usr/bin/env python3
"""slurm-top: An htop-like real-time dashboard for Slurm clusters.

One file for every cluster (raven, viper, dais, sws-grid, ...). Cluster
specifics are read live from `scontrol show config` (name, priority weights,
usage decay) plus a small optional per-cluster profile below.

    slurm-top            interactive curses dashboard
    slurm-top --json     one-shot JSON snapshot (GPUs, queue, my jobs,
                         priority rank, fairshare, leaderboard, history)

Python 3.6+ (dais still runs 3.6).
"""

import argparse
import json
import math
import os
import re
import signal
import subprocess
import sys
import time
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta

REFRESH_INTERVAL = 3   # seconds, fast data (sinfo/scontrol/squeue)
SLOW_INTERVAL = 15     # seconds, slow data (sprio/sshare/sacct)

# ── Per-cluster profiles (everything else is auto-detected) ──────────────────
# Keyed by ClusterName from `scontrol show config`.
#   untyped_gpu_features: node feature -> GPU model, for clusters that expose
#                         GPUs as plain gres/gpu (Viper's MI300A APUs).
#   partition_notes:      short usage hints shown next to partition bars.
PROFILES = {
    "raven": {
        "partition_notes": {
            "gpu": "exclusive full nodes (4x A100)",
            "gpu1": "shared; 1-2 GPUs",
            "gpudev": "debug; 15 min",
            "general": "CPU; full nodes",
            "small": "CPU; shared nodes",
            "interactive": "login-like; 2 h",
            "rvs": "reservations",
        },
    },
    "viper": {
        "untyped_gpu_features": {"apu": "mi300a"},
        "partition_notes": {
            "apu": "exclusive full nodes (2x MI300A)",
            "apu1": "shared; 1 APU",
            "apudev": "debug; 15 min",
            "general": "CPU; full nodes",
            "small": "CPU; shared nodes",
            "interactive": "login-like; 2 h",
            "datatransfer": "I/O; 6 h",
        },
    },
    "dais": {
        "partition_notes": {
            "gpu": "exclusive full nodes (8 GPU)",
            "gpu1": "shared; <4 GPUs; 12 cpu/250G per GPU",
            "gpudev": "debug; 15 min; 4 GPU; 1 job/user",
            "small": "CPU only; 6 h",
            "rvs": "reservations",
        },
    },
    "sws-grid": {
        "partition_notes": {
            "spyder": "CPU only",
        },
        # Access is per account; each account unlocks only these GPU types.
        # GPUs of other types are reported but marked "not usable".
        "account_gpu_types": {
            "aics_h100": ["h100"],
            "aics_h200": ["h200"],
        },
    },
}

CLUSTER = {
    "name": os.environ.get("SLURM_CLUSTER_NAME", "slurm"),
    "w_fairshare": 0, "w_age": 0, "w_jobsize": 0, "w_partition": 0,
    "w_qos": 0, "w_assoc": 0,
    "max_age_s": None, "half_life_s": 0, "usage_reset": "NONE",
    "priority_type": "", "priority_flags": "",
}
PROFILE = {}


# ── Helpers ──────────────────────────────────────────────────────────────────

def run_cmd(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, shell=True, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, universal_newlines=True,
                           timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def _int(s, default=0):
    s = (s or "").strip()
    return int(s) if s.lstrip("-").isdigit() else default


def _float(s, default=0.0):
    try:
        return float((s or "").strip())
    except ValueError:
        return default


def parse_time_to_seconds(t):
    """Parse Slurm time (D-HH:MM:SS, HH:MM:SS, MM:SS) to seconds; None if n/a."""
    if not t or t in ("UNLIMITED", "INVALID", "Partition_Limit", "N/A", "NONE"):
        return None
    try:
        days = 0
        if "-" in t:
            d, t = t.split("-", 1)
            days = int(d)
        parts = [int(p) for p in t.split(":")]
        if len(parts) == 3:
            return days * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
        if len(parts) == 2:
            return days * 86400 + parts[0] * 60 + parts[1]
        if len(parts) == 1:
            return days * 86400 + parts[0]
    except ValueError:
        pass
    return None


def seconds_to_human(s):
    if s is None or s < 0:
        return "N/A"
    s = int(s)
    d, h, m = s // 86400, (s % 86400) // 3600, (s % 3600) // 60
    if d > 0:
        return f"{d}d{h:02d}h{m:02d}m"
    if h > 0:
        return f"{h}h{m:02d}m"
    return f"{m}m"


def format_usage(val):
    val = val or 0
    if val >= 1_000_000_000:
        return f"{val / 1_000_000_000:.1f}G"
    if val >= 1_000_000:
        return f"{val / 1_000_000:.1f}M"
    if val >= 1_000:
        return f"{val / 1_000:.1f}K"
    return str(int(val))


def fmt_lfs(lfs):
    if lfs in ("inf", "", None):
        return "inf"
    try:
        v = float(lfs)
    except (TypeError, ValueError):
        return str(lfs)[:7]
    return f"{v:.3f}" if v < 100 else f"{v:.0f}"


def lfs_value(lfs):
    try:
        return float(lfs)
    except (TypeError, ValueError):
        return float("inf")


def parse_slurm_datetime(s):
    if not s or s in ("N/A", "Unknown", "None"):
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S"):
        try:
            return datetime.strptime(s, fmt)
        except ValueError:
            continue
    return None


def expand_nodelist(nodelist):
    """Expand 'daisg[101-103,105],ravg1001' to a list of node names."""
    nodes = []
    for m in re.finditer(r'([^,\[]+)(?:\[([^\]]+)\])?,?', nodelist or ""):
        prefix, ranges = m.group(1), m.group(2)
        if not ranges:
            nodes.append(prefix)
            continue
        for r in ranges.split(","):
            try:
                if "-" in r:
                    a, b = r.split("-", 1)
                    nodes.extend(f"{prefix}{i:0{len(a)}d}" for i in range(int(a), int(b) + 1))
                else:
                    nodes.append(prefix + r)
            except ValueError:
                continue
    return nodes


# ── Cluster config ───────────────────────────────────────────────────────────

def load_cluster_config():
    global PROFILE
    raw = run_cmd("scontrol show config")
    for line in raw.splitlines():
        if "=" not in line:
            continue
        k, v = (s.strip() for s in line.split("=", 1))
        if k == "ClusterName":
            CLUSTER["name"] = v
        elif k == "PriorityType":
            CLUSTER["priority_type"] = v
        elif k == "PriorityFlags":
            CLUSTER["priority_flags"] = v
        elif k == "PriorityWeightFairShare":
            CLUSTER["w_fairshare"] = _int(v)
        elif k == "PriorityWeightAge":
            CLUSTER["w_age"] = _int(v)
        elif k == "PriorityWeightJobSize":
            CLUSTER["w_jobsize"] = _int(v)
        elif k == "PriorityWeightPartition":
            CLUSTER["w_partition"] = _int(v)
        elif k == "PriorityWeightQOS":
            CLUSTER["w_qos"] = _int(v)
        elif k == "PriorityWeightAssoc":
            CLUSTER["w_assoc"] = _int(v)
        elif k == "PriorityMaxAge":
            CLUSTER["max_age_s"] = parse_time_to_seconds(v)
        elif k == "PriorityDecayHalfLife":
            CLUSTER["half_life_s"] = parse_time_to_seconds(v) or 0
        elif k == "PriorityUsageResetPeriod":
            CLUSTER["usage_reset"] = v
    PROFILE = PROFILES.get(CLUSTER["name"], {})
    return CLUSTER


def priority_summary_line():
    c = CLUSTER
    weights = [("fairshare", c["w_fairshare"]), ("qos", c["w_qos"]),
               ("partition", c["w_partition"]), ("jobsize", c["w_jobsize"]),
               ("age", c["w_age"])]
    parts = [f"{k} {format_usage(v)}" for k, v in weights if v]
    if c["max_age_s"]:
        parts.append(f"age maxes after {seconds_to_human(c['max_age_s'])}")
    if c["half_life_s"]:
        parts.append(f"usage half-life {seconds_to_human(c['half_life_s'])}")
    elif c["usage_reset"] and c["usage_reset"] != "NONE":
        parts.append(f"usage reset {c['usage_reset']}")
    else:
        parts.append("usage never decays")
    return "Weights: " + "  ".join(parts)


# ── Data collection ──────────────────────────────────────────────────────────

def get_partitions():
    raw = run_cmd('sinfo -o "%P|%C|%G|%D|%F|%l|%a" --noheader')
    partitions = {}
    for line in raw.splitlines():
        parts = line.split("|")
        if len(parts) < 6:
            continue
        name = parts[0].rstrip("*")
        is_default = parts[0].endswith("*")
        cpus = parts[1].split("/")
        if len(cpus) != 4:
            continue
        alloc, idle, other, total = (_int(x) for x in cpus)
        gres = parts[2]
        num_nodes = _int(parts[3])
        ns = parts[4].split("/")
        n_alloc, n_idle, n_other, n_total = (_int(x) for x in ns) if len(ns) == 4 else (0, 0, 0, num_nodes)
        time_limit = parts[5]
        avail = parts[6].strip() if len(parts) > 6 else "up"
        gpu_type, gpu_per_node = "", 0
        m = re.search(r'gpu:([\w.-]+):(\d+)', gres) or re.search(r'gpu:(\d+)', gres)
        if m:
            if m.lastindex == 2:
                gpu_type, gpu_per_node = m.group(1), int(m.group(2))
            else:
                gpu_per_node = int(m.group(1))
        has_gpu = gpu_per_node > 0
        p = partitions.get(name)
        if p is None:
            p = partitions[name] = {
                "name": name, "default": is_default, "avail": avail,
                "cpu_alloc": 0, "cpu_idle": 0, "cpu_other": 0, "cpu_total": 0,
                "num_nodes": 0, "n_alloc": 0, "n_idle": 0, "n_other": 0, "n_total": 0,
                "has_gpu": False, "gpu_types": [], "time_limit": time_limit,
                "note": PROFILE.get("partition_notes", {}).get(name, ""),
            }
        p["cpu_alloc"] += alloc
        p["cpu_idle"] += idle
        p["cpu_other"] += other
        p["cpu_total"] += total
        p["num_nodes"] += num_nodes
        p["n_alloc"] += n_alloc
        p["n_idle"] += n_idle
        p["n_other"] += n_other
        p["n_total"] += n_total
        if has_gpu:
            p["has_gpu"] = True
            if gpu_type and gpu_type not in p["gpu_types"]:
                p["gpu_types"].append(gpu_type)
    return partitions


def get_nodes():
    """Parse `scontrol show nodes` once; derive everything node-related.

    Returns dict with:
      gpu_by_type    {type: {total, alloc, nodes, unavail}}
      gpu_by_partition {partition: {type: {total, alloc}}}
      node_types     {node: type}
      partition_types {partition: type|'any'}
      node_states    {state: count}
      total_gpus, total_gpu_alloc, unavail_gpus, n_nodes
    """
    raw = run_cmd("scontrol show nodes", timeout=30)
    feature_types = PROFILE.get("untyped_gpu_features", {})
    by_type = defaultdict(lambda: {"total": 0, "alloc": 0, "free": 0, "nodes": 0, "unavail": 0})
    by_part = defaultdict(lambda: defaultdict(lambda: {"total": 0, "alloc": 0}))
    part_type_sets = defaultdict(set)
    node_types = {}
    node_states = defaultdict(int)
    totals = {"gpus": 0, "alloc": 0, "free": 0, "unavail": 0, "nodes": 0}

    cur = {}

    def flush():
        if not cur:
            return
        totals["nodes"] += 1
        node_states[cur.get("state", "unknown")] += 1
        cfg, alloc = cur.get("cfg", {}), cur.get("alloc", {})
        if not cfg:
            return
        if set(cfg) == {"gpu"}:
            gtype = next((t for f, t in feature_types.items() if f in cur.get("features", ())), "gpu")
            cfg = {gtype: cfg["gpu"]}
            alloc = {gtype: alloc.get("gpu", 0)}
        for gtype, n in cfg.items():
            a = alloc.get(gtype, 0)
            e = by_type[gtype]
            e["total"] += n
            e["alloc"] += a
            e["nodes"] += 1
            if cur.get("unavail"):
                e["unavail"] += n
                totals["unavail"] += n
            else:
                # free = schedulable right now: idle GPUs on healthy nodes only
                e["free"] += max(0, n - a)
                totals["free"] += max(0, n - a)
            node_types[cur["name"]] = gtype
            for p in cur.get("partitions", []):
                by_part[p][gtype]["total"] += n
                by_part[p][gtype]["alloc"] += a
                part_type_sets[p].add(gtype)
            totals["gpus"] += n
            totals["alloc"] += a

    for line in raw.splitlines():
        line = line.strip()
        if line.startswith("NodeName="):
            flush()
            cur = {"name": line.split()[0].split("=", 1)[1], "cfg": {}, "alloc": {}}
        elif not cur:
            continue
        elif line.startswith("State="):
            state = line.split()[0].split("=", 1)[1]
            cur["state"] = state.lower()
            up = state.upper()
            cur["unavail"] = any(s in up for s in ("DOWN", "DRAIN", "MAINT", "FAIL", "NOT_RESPONDING"))
        elif line.startswith("AvailableFeatures="):
            v = line.split("=", 1)[1].split()[0]
            cur["features"] = set(v.split(",")) if v not in ("(null)", "N/A") else set()
        elif line.startswith("Partitions="):
            cur["partitions"] = line.split("=", 1)[1].split()[0].split(",")
        elif line.startswith("CfgTRES="):
            for m in re.finditer(r'gres/gpu:([\w.-]+)=(\d+)', line):
                cur["cfg"][m.group(1)] = int(m.group(2))
            if not cur["cfg"]:
                m = re.search(r'gres/gpu=(\d+)', line)
                if m and int(m.group(1)) > 0:
                    cur["cfg"]["gpu"] = int(m.group(1))
        elif line.startswith("AllocTRES="):
            for m in re.finditer(r'gres/gpu:([\w.-]+)=(\d+)', line):
                cur["alloc"][m.group(1)] = int(m.group(2))
            if not cur["alloc"]:
                m = re.search(r'gres/gpu=(\d+)', line)
                if m:
                    cur["alloc"]["gpu"] = int(m.group(1))
    flush()

    partition_types = {p: (next(iter(t)) if len(t) == 1 else "any") for p, t in part_type_sets.items()}
    return {
        "gpu_by_type": {k: dict(v) for k, v in by_type.items()},
        "gpu_by_partition": {p: {t: dict(v) for t, v in d.items()} for p, d in by_part.items()},
        "node_types": node_types,
        "partition_types": partition_types,
        "node_states": dict(node_states),
        "total_gpus": totals["gpus"],
        "total_gpu_alloc": totals["alloc"],
        "free_gpus": totals["free"],
        "unavail_gpus": totals["unavail"],
        "n_nodes": totals["nodes"],
    }


def annotate_partitions(partitions, nodes):
    """Fill partition GPU types/counts from node data (sinfo GRES may be untyped)."""
    for name, p in partitions.items():
        by_type = nodes.get("gpu_by_partition", {}).get(name, {})
        if by_type:
            p["has_gpu"] = True
            p["gpu_types"] = sorted(by_type, key=lambda t: -by_type[t]["total"])
            p["gpu_total"] = sum(v["total"] for v in by_type.values())
            p["gpu_alloc"] = sum(v["alloc"] for v in by_type.values())
    return partitions


def get_jobs():
    raw = run_cmd('squeue -o "%i|%P|%j|%u|%T|%M|%D|%C|%b|%R|%V|%l|%S|%a|%Q|%q" --noheader')
    jobs = []
    for line in raw.splitlines():
        p = line.split("|")
        if len(p) < 13:
            continue
        jobs.append({
            "id": p[0].strip(), "partition": p[1].strip(), "name": p[2].strip(),
            "user": p[3].strip(), "state": p[4].strip(), "time": p[5].strip(),
            "nodes": p[6].strip(), "cpus": p[7].strip(), "gres": p[8].strip(),
            "reason": p[9].strip(), "submit_time": p[10].strip(),
            "time_limit": p[11].strip(), "start_time": p[12].strip(),
            "account": p[13].strip() if len(p) > 13 else "",
            "priority": _int(p[14]) if len(p) > 14 else 0,
            "qos": p[15].strip() if len(p) > 15 else "",
            "tasks": array_task_count(p[0].strip()),
        })
    return jobs


def array_task_count(job_id):
    """Number of tasks a squeue row stands for: '123_[1-14]' -> 14, '123_[2,5-7%3]' -> 4, else 1."""
    m = re.search(r'_\[([^\]]+)\]', job_id)
    if not m:
        return 1
    spec = m.group(1).split("%", 1)[0]
    n = 0
    for part in spec.split(","):
        if "-" in part:
            a, b = part.split("-", 1)
            try:
                n += int(b) - int(a) + 1
            except ValueError:
                n += 1
        elif part.strip():
            n += 1
    return max(1, n)


def base_job_id(job_id):
    """'5849387_[2-7]' / '5849387_3' -> '5849387' (sprio reports array jobs by base id)."""
    return job_id.split("_", 1)[0]


def job_gpu_count(job):
    m = re.search(r'(?:gres/)?gpu(?::[A-Za-z_][\w.-]*)?:(\d+)', job.get("gres", ""))
    if not m:
        return 0
    nodes = _int(job.get("nodes", ""), 1) or 1
    return int(m.group(1)) * nodes


def job_gpu_type(job, node_types, partition_types):
    gres = job.get("gres", "")
    m = re.search(r'gpu:([A-Za-z_][\w.-]*):', gres)
    if m:
        return m.group(1)
    if "gpu" not in gres:
        return ""
    if job.get("state") == "RUNNING":
        for node in expand_nodelist(job.get("reason", "")):
            t = node_types.get(node)
            if t:
                return t
    return partition_types.get(job.get("partition", ""), "any")


def job_eta(job):
    """(label, seconds) — remaining time for running jobs, expected start for pending."""
    if job["state"] == "RUNNING":
        el, lim = parse_time_to_seconds(job["time"]), parse_time_to_seconds(job["time_limit"])
        if el is not None and lim is not None:
            return f"{seconds_to_human(lim - el)} left", lim - el
        return "-", None
    if job["state"] == "PENDING":
        st = parse_slurm_datetime(job.get("start_time", ""))
        if st:
            delta = (st - datetime.now()).total_seconds()
            return (f"in {seconds_to_human(delta)}" if delta > 0 else "starting..."), max(0, delta)
        reason = job.get("reason", "")
        return (reason if reason and reason != "None" else "waiting"), None
    return "", None


def get_user_summary(jobs):
    users = defaultdict(lambda: {"running": 0, "pending": 0, "cpus": 0, "gpus": 0})
    for j in jobs:
        u = users[j["user"]]
        if j["state"] == "RUNNING":
            u["running"] += 1
            u["cpus"] += _int(j["cpus"])
            u["gpus"] += job_gpu_count(j)
        else:
            u["pending"] += 1
    return dict(users)


def get_priority_data(jobs=None):
    """Whole pending queue with priority factors, ranked. One sprio call.

    With PriorityFlags=CALCULATE_RUNNING sprio also lists running jobs, so when
    the squeue job list is given only PENDING jobs are kept and ranked.
    """
    raw = run_cmd('sprio -o "%i|%u|%o|%r|%Y|%A|%F|%J|%P|%Q|%N" --noheader', timeout=30)
    pending_ids = None
    if jobs is not None:
        pending_ids = set()
        for j in jobs:
            if j["state"] == "PENDING":
                pending_ids.add(j["id"])
                pending_ids.add(base_job_id(j["id"]))
    entries = []
    for line in raw.splitlines():
        p = line.split("|")
        if len(p) < 11:
            continue
        jid = p[0].strip()
        if pending_ids is not None and jid not in pending_ids and base_job_id(jid) not in pending_ids:
            continue
        entries.append({
            "id": p[0].strip(), "user": p[1].strip(), "account": p[2].strip(),
            "partition_name": p[3].strip(), "priority": _int(p[4]),
            "age": _int(p[5]), "fairshare": _int(p[6]), "jobsize": _int(p[7]),
            "partition": _int(p[8]), "qos": _int(p[9]), "nice": _int(p[10]),
        })
    entries.sort(key=lambda e: e["priority"], reverse=True)
    for rank, e in enumerate(entries, 1):
        e["rank"] = rank
    return entries


def rank_pending_only(entries, jobs):
    """Drop non-pending jobs from sprio output (CALCULATE_RUNNING) and re-rank."""
    pending = set()
    for j in jobs:
        if j["state"] == "PENDING":
            pending.add(j["id"])
            pending.add(base_job_id(j["id"]))
    kept = [e for e in entries if e["id"] in pending or base_job_id(e["id"]) in pending]
    kept.sort(key=lambda e: e["priority"], reverse=True)
    for rank, e in enumerate(kept, 1):
        e["rank"] = rank
    return kept


def _parse_tres(tres_str):
    """'cpu=..,gres/gpu=..,gres/gpu:h200=..' -> {'cpu': n, 'gpu': n, 'h200': n}."""
    out = {}
    for m in re.finditer(r'(cpu|gres/gpu(?::[\w.-]+)?)=(\d+)', tres_str or ""):
        key = m.group(1).replace("gres/gpu:", "").replace("gres/gpu", "gpu")
        out[key] = int(m.group(2))
    return out


def get_sshare_tree(current_user):
    """Parse the whole fairshare tree with ONE `sshare -a -l` call.

    Fair-tree ranking is by LevelFS at each level: accounts compete under
    root, users compete within their account.
    Returns {"root": row|None, "accounts": [...], "users": {acct: [...]},
             "my_accounts": [...my user rows...]}.
    """
    raw = run_cmd("sshare -a -l --parsable2", timeout=60)
    root = None
    accounts = []
    users = defaultdict(list)
    my_accounts = []
    for line in raw.splitlines():
        p = line.split("|")
        if len(p) < 9 or p[0].strip() == "Account":
            continue
        account, user = p[0].strip(), p[1].strip()
        entry = {
            "account": account, "user": user,
            "raw_shares": _int(p[2]), "norm_shares": _float(p[3]),
            "raw_usage": _int(p[4]), "norm_usage": _float(p[5]),
            "effectv_usage": _float(p[6]), "fairshare": _float(p[7]),
            "level_fs": p[8].strip(),
            "tres_run_mins": _parse_tres(p[10] if len(p) > 10 else ""),
        }
        if account == "root" and not user:
            root = entry
        elif account == "root":
            continue
        elif not user:
            accounts.append(entry)
        else:
            users[account].append(entry)
            if user == current_user:
                my_accounts.append(entry)

    def key(e):
        return (lfs_value(e["level_fs"]), -e["raw_usage"])

    accounts.sort(key=key, reverse=True)
    for rank, a in enumerate(accounts, 1):
        a["rank"] = rank
    for lst in users.values():
        lst.sort(key=key, reverse=True)
        for rank, u in enumerate(lst, 1):
            u["rank"] = rank
    return {"root": root, "accounts": accounts, "users": dict(users), "my_accounts": my_accounts}


def hours_to_fair(level_fs):
    """Hours of zero usage until LevelFS reaches 1.0, given the decay half-life.

    Only meaningful when usage decays (PriorityDecayHalfLife > 0). Ignores
    other users' usage also decaying, so it is an optimistic estimate.
    """
    hl = CLUSTER.get("half_life_s") or 0
    if hl <= 0:
        return None
    lfs = lfs_value(level_fs)
    if lfs >= 1.0 or lfs <= 0:
        return 0.0
    return math.log2(1.0 / lfs) * hl / 3600.0


def usable_gpu_types(gpu_by_type, my_accounts):
    """GPU types the user may actually use. Without a profile rule, all of them."""
    rule = PROFILE.get("account_gpu_types")
    if not rule:
        return sorted(gpu_by_type)
    allowed = set()
    for acct in my_accounts:
        allowed.update(rule.get(acct, []))
    return sorted(t for t in gpu_by_type if t in allowed)


def fairshare_summary(tree, current_user):
    """Per account I belong to: my row, the account row, ranks, members."""
    out = []
    acct_by_name = {a["account"]: a for a in tree.get("accounts", [])}
    n_accts = len(tree.get("accounts", []))
    root_usage = (tree.get("root") or {}).get("raw_usage", 0)
    for me in tree.get("my_accounts", []):
        acct = acct_by_name.get(me["account"])
        members = tree.get("users", {}).get(me["account"], [])
        active = [u for u in members if u["raw_usage"] > 0]
        acct_usage = acct["raw_usage"] if acct else sum(u["raw_usage"] for u in members)
        top = max(active, key=lambda u: u["raw_usage"]) if active else None
        out.append({
            "account": me["account"],
            "me": me,
            "account_row": acct,
            "n_accounts": n_accts,
            "n_members": len(members),
            "n_active_members": len(active),
            "account_usage": acct_usage,
            "cluster_usage": root_usage,
            "my_share_of_account": me["raw_usage"] / acct_usage if acct_usage else 0.0,
            "fair_share_of_account": 1.0 / len(members) if members else 0.0,
            "account_share_of_cluster": (acct["raw_usage"] / root_usage) if (acct and root_usage) else 0.0,
            "account_usage_vs_share": (acct["norm_usage"] / acct["norm_shares"]) if (acct and acct["norm_shares"] > 0) else None,
            "hours_to_fair_me": hours_to_fair(me["level_fs"]),
            "hours_to_fair_account": hours_to_fair(acct["level_fs"]) if acct else None,
            "priority_contribution": int(me["fairshare"] * CLUSTER["w_fairshare"]),
            "heaviest_member": {"user": top["user"], "share": top["raw_usage"] / acct_usage if acct_usage else 0} if top else None,
        })
    return out


def get_recent_history(current_user, days=7):
    start = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")
    raw = run_cmd(
        f'sacct -u {current_user} --starttime={start} -X '
        f'-o JobID,JobName%60,State%24,ExitCode,Elapsed,Partition,AllocTRES%80,Start,End,NodeList%40 '
        f'--parsable2 --noheader', timeout=60)
    jobs = []
    for line in raw.splitlines():
        p = line.split("|")
        if len(p) < 7:
            continue
        state = p[2].strip().split()[0] if p[2].strip() else ""
        tres = _parse_tres(p[6])
        gtype = next((k for k in tres if k not in ("cpu", "gpu")), "")
        jobs.append({
            "id": p[0].strip(), "name": p[1].strip(), "state": state,
            "exit_code": p[3].strip(), "elapsed": p[4].strip(),
            "partition": p[5].strip(), "gpus": tres.get("gpu", 0),
            "gpu_type": gtype, "cpus": tres.get("cpu", 0),
            "start": p[7].strip() if len(p) > 7 else "",
            "end": p[8].strip() if len(p) > 8 else "",
            "nodelist": p[9].strip() if len(p) > 9 else "",
        })
    return jobs


def fetch_fast():
    """sinfo + scontrol + squeue in parallel."""
    with ThreadPoolExecutor(max_workers=3) as ex:
        fp, fn, fj = ex.submit(get_partitions), ex.submit(get_nodes), ex.submit(get_jobs)
        return fp.result(), fn.result(), fj.result()


# ── JSON snapshot ────────────────────────────────────────────────────────────

def collect_snapshot(current_user, history_days=7, leaderboard_limit=50):
    with ThreadPoolExecutor(max_workers=6) as ex:
        f_part = ex.submit(get_partitions)
        f_nodes = ex.submit(get_nodes)
        f_jobs = ex.submit(get_jobs)
        f_prio = ex.submit(get_priority_data)
        f_tree = ex.submit(get_sshare_tree, current_user)
        f_hist = ex.submit(get_recent_history, current_user, history_days)
        partitions, nodes, jobs = f_part.result(), f_nodes.result(), f_jobs.result()
        priority, tree, history = f_prio.result(), f_tree.result(), f_hist.result()
    priority = rank_pending_only(priority, jobs)

    node_types, partition_types = nodes["node_types"], nodes["partition_types"]
    user_summary = get_user_summary(jobs)
    annotate_partitions(partitions, nodes)

    def enrich(j):
        label, secs = job_eta(j)
        out = dict(j)
        out["gpu_count"] = job_gpu_count(j)
        out["gpu_type"] = job_gpu_type(j, node_types, partition_types)
        out["eta"] = label
        out["eta_seconds"] = secs
        if j["state"] == "RUNNING":
            out["nodelist"] = j["reason"]
            out["reason"] = ""
        return out

    if len(nodes["gpu_by_type"]) == 1:
        only_type = next(iter(nodes["gpu_by_type"]))
        for h in history:
            if h["gpus"] and not h["gpu_type"]:
                h["gpu_type"] = only_type

    my_jobs = [enrich(j) for j in jobs if j["user"] == current_user]
    prio_by_id = {p["id"]: p for p in priority}
    for j in my_jobs:
        pr = prio_by_id.get(j["id"]) or prio_by_id.get(base_job_id(j["id"]))
        if pr:
            j["queue_rank"] = pr["rank"]
            j["priority_factors"] = {k: pr[k] for k in ("age", "fairshare", "jobsize", "partition", "qos", "nice")}

    my_prio = [p for p in priority if p["user"] == current_user]
    running = [j for j in jobs if j["state"] == "RUNNING"]
    pending = [j for j in jobs if j["state"] == "PENDING"]

    gpu_by_type = nodes["gpu_by_type"]
    my_account_names = [m["account"] for m in tree.get("my_accounts", [])]
    usable_types = usable_gpu_types(gpu_by_type, my_account_names)
    usable_rows = [gpu_by_type[t] for t in usable_types]
    gpus = {
        "usable_types": usable_types,
        "usable": {
            "total": sum(v["total"] for v in usable_rows),
            "allocated": sum(v["alloc"] for v in usable_rows),
            "free": sum(v["free"] for v in usable_rows),
            "unavailable": sum(v["unavail"] for v in usable_rows),
        },
        "total": nodes["total_gpus"],
        "allocated": nodes["total_gpu_alloc"],
        "free": nodes["free_gpus"],  # schedulable now; excludes down/drain/maint nodes
        "unavailable": nodes["unavail_gpus"],
        "usage_pct": round(100.0 * nodes["total_gpu_alloc"] / nodes["total_gpus"], 1) if nodes["total_gpus"] else 0.0,
        "by_type": {
            t: dict(v, usage_pct=round(100.0 * v["alloc"] / v["total"], 1) if v["total"] else 0.0)
            for t, v in gpu_by_type.items()
        },
        "by_partition": nodes["gpu_by_partition"],
        "pending_requests": sum(job_gpu_count(j) * j["tasks"] for j in pending),
        "my_running": sum(j["gpu_count"] for j in my_jobs if j["state"] == "RUNNING"),
        "my_pending": sum(j["gpu_count"] * j["tasks"] for j in my_jobs if j["state"] == "PENDING"),
    }

    top_users = sorted(user_summary.items(), key=lambda kv: (kv[1]["gpus"], kv[1]["running"]), reverse=True)
    my_accounts = {a["account"] for a in fairshare_summary(tree, current_user)}
    lb_accounts = tree["accounts"][:leaderboard_limit]
    lb_accounts += [a for a in tree["accounts"][leaderboard_limit:] if a["account"] in my_accounts]

    return {
        "generated_at": datetime.now().isoformat(timespec="seconds"),
        "cluster": dict(CLUSTER, user=current_user, hostname=os.uname().nodename,
                        priority_summary=priority_summary_line()),
        "gpus": gpus,
        "partitions": sorted(partitions.values(), key=lambda p: (not p["default"], not p["has_gpu"], p["name"])),
        "nodes": {"total": nodes["n_nodes"], "states": nodes["node_states"]},
        "queue": {
            "running": sum(j["tasks"] for j in running), "pending": sum(j["tasks"] for j in pending),
            "other": len(jobs) - len(running) - len(pending), "total": sum(j["tasks"] for j in jobs),
            "users_active": len(user_summary),
            "top_users": [dict(stats, user=u) for u, stats in top_users[:15]],
        },
        "my_jobs": {
            # counts are array tasks, not squeue rows ('123_[1-14]' counts 14)
            "running": sum(j["tasks"] for j in my_jobs if j["state"] == "RUNNING"),
            "pending": sum(j["tasks"] for j in my_jobs if j["state"] == "PENDING"),
            "total": sum(j["tasks"] for j in my_jobs),
            "rows": len(my_jobs),
            "jobs": sorted(my_jobs, key=lambda j: (j["state"] != "RUNNING", j["state"] != "PENDING", j["id"])),
        },
        "priority": {
            "queue_size": len(priority),
            "my_best_rank": min((p["rank"] for p in my_prio), default=None),
            "my_jobs": my_prio,
            "top_of_queue": priority[:5],
            "weights": {k: CLUSTER[k] for k in ("w_fairshare", "w_age", "w_jobsize", "w_partition", "w_qos")},
        },
        "fairshare": {
            "accounts": fairshare_summary(tree, current_user),
            "half_life_seconds": CLUSTER["half_life_s"],
            "usage_reset": CLUSTER["usage_reset"],
        },
        "leaderboard": {
            "accounts": lb_accounts,
            "members": {a: tree["users"].get(a, []) for a in sorted(my_accounts)},
        },
        "history": {"days": history_days, "jobs": history},
    }


# ── Curses UI ────────────────────────────────────────────────────────────────

import curses  # noqa: E402  (after data code so --json works without a TTY)


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    curses.init_pair(3, curses.COLOR_RED, -1)
    curses.init_pair(4, curses.COLOR_CYAN, -1)
    curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLUE)
    curses.init_pair(6, curses.COLOR_MAGENTA, -1)
    curses.init_pair(7, curses.COLOR_WHITE, -1)
    curses.init_pair(11, curses.COLOR_BLACK, curses.COLOR_CYAN)


def safe_addstr(win, y, x, s, attr=0):
    max_y, max_x = win.getmaxyx()
    if y >= max_y or y < 0 or x >= max_x - 1:
        return
    s = s[:max(0, max_x - x - 1)]
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass


def draw_bar(win, y, x, width, fraction, label):
    max_y, max_x = win.getmaxyx()
    if y >= max_y - 1 or x + width > max_x:
        return
    fraction = max(0.0, min(1.0, fraction))
    filled = int(fraction * (width - 2))
    c = curses.color_pair(1 if fraction < 0.5 else 2 if fraction < 0.8 else 3) | curses.A_BOLD
    try:
        win.addstr(y, x, "[", curses.color_pair(7))
        if filled > 0:
            win.addstr(y, x + 1, "|" * filled, c)
        win.addstr(y, x + width - 1, "]", curses.color_pair(7))
        pct = f" {fraction * 100:.0f}%"
        pos = x + width + 1
        if pos + len(pct) + len(label) < max_x:
            win.addstr(y, pos, label, curses.color_pair(7) | curses.A_DIM)
            win.addstr(y, pos + len(label), pct, curses.color_pair(7))
    except curses.error:
        pass


def draw_colored_bar(win, y, x, width, fraction, color_pair):
    max_y, max_x = win.getmaxyx()
    if y >= max_y - 1 or x + width > max_x:
        return
    fraction = max(0.0, min(1.0, fraction))
    filled = int(fraction * (width - 2))
    try:
        win.addstr(y, x, "[", curses.color_pair(7))
        if filled > 0:
            win.addstr(y, x + 1, "|" * filled, curses.color_pair(color_pair) | curses.A_BOLD)
        win.addstr(y, x + width - 1, "]", curses.color_pair(7))
    except curses.error:
        pass


def draw_header(win, y, width, current_user, view_name):
    ts = time.strftime("%H:%M:%S")
    title = " SLURM-TOP "
    left = f" {current_user}@{CLUSTER['name']}"
    right = f"{view_name} | Refresh: {REFRESH_INTERVAL}s | {ts} "
    safe_addstr(win, y, 0, " " * (width - 1), curses.color_pair(5))
    safe_addstr(win, y, 1, left, curses.color_pair(5) | curses.A_BOLD)
    safe_addstr(win, y, max(0, (width - len(title)) // 2), title, curses.color_pair(5) | curses.A_BOLD)
    if width - len(right) - 1 > 0:
        safe_addstr(win, y, width - len(right) - 1, right, curses.color_pair(5))
    return y + 1


def draw_partition_bars(win, y, partitions, nodes, width, usable_types=None):
    bar_width = max(10, min(50, width - 40))
    label_width = 20
    info_col = label_width + bar_width + 22
    gpu_by_type = nodes.get("gpu_by_type", {})
    total_gpus, total_alloc = nodes.get("total_gpus", 0), nodes.get("total_gpu_alloc", 0)

    safe_addstr(win, y, 1, "GPUs BY TYPE", curses.color_pair(4) | curses.A_BOLD)
    if info_col + 12 < width:
        safe_addstr(win, y, info_col, "NODES", curses.color_pair(7) | curses.A_DIM)
    y += 1
    if total_gpus > 0:
        safe_addstr(win, y, 0, f" {'Total':>14s} GPU", curses.color_pair(6) | curses.A_BOLD)
        draw_bar(win, y, label_width, bar_width, total_alloc / total_gpus, f"{total_alloc}/{total_gpus}")
        y += 1
    for gtype in sorted(gpu_by_type, key=lambda t: gpu_by_type[t]["total"], reverse=True):
        if y >= win.getmaxyx()[0] - 2:
            break
        g = gpu_by_type[gtype]
        safe_addstr(win, y, 0, f" {gtype.upper():>18s}", curses.color_pair(6))
        draw_bar(win, y, label_width, bar_width, g["alloc"] / g["total"] if g["total"] else 0, f"{g['alloc']}/{g['total']}")
        if info_col < width:
            info = f"{g['nodes']} nodes, {g['free']} free"
            safe_addstr(win, y, info_col, info, curses.color_pair(7) | curses.A_DIM)
            if g["unavail"] > 0:
                safe_addstr(win, y, info_col + len(info), f" ({g['unavail']} unavail)", curses.color_pair(3))
                info += f" ({g['unavail']} unavail)"
            if usable_types is not None and gtype not in usable_types:
                safe_addstr(win, y, info_col + len(info), " not usable by me", curses.color_pair(7) | curses.A_DIM)
        y += 1
    if not gpu_by_type:
        safe_addstr(win, y, 2, "No GPUs in this cluster.", curses.color_pair(7) | curses.A_DIM)
        y += 1
    y += 1

    safe_addstr(win, y, 1, "PARTITIONS (CPU)", curses.color_pair(4) | curses.A_BOLD)
    if info_col + 12 < width:
        safe_addstr(win, y, info_col, "LIMIT", curses.color_pair(7) | curses.A_DIM)
    y += 1
    for p in sorted(partitions.values(), key=lambda p: (not p["default"], not p["has_gpu"], p["name"])):
        if y >= win.getmaxyx()[0] - 2:
            break
        total, alloc = p["cpu_total"], p["cpu_alloc"]
        safe_addstr(win, y, 0, f" {p['name']:>14s} CPU", curses.color_pair(4))
        draw_bar(win, y, label_width, bar_width, alloc / total if total else 0, f"{alloc}/{total}")
        if info_col < width:
            safe_addstr(win, y, info_col, f"{p.get('time_limit', ''):<11}", curses.color_pair(7) | curses.A_DIM)
            note = p.get("note") or (", ".join(p["gpu_types"]) if p["gpu_types"] else "")
            if note:
                safe_addstr(win, y, info_col + 12, note, curses.color_pair(7) | curses.A_DIM)
        y += 1
    return y + 1


def draw_node_summary(win, y, node_states, width):
    safe_addstr(win, y, 1, "NODES", curses.color_pair(4) | curses.A_BOLD)
    y += 1
    groups = {"allocated": 0, "mixed": 0, "idle": 0, "completing": 0,
              "drained": 0, "down": 0, "planned": 0, "other": 0}
    total = 0
    for state, count in node_states.items():
        total += count
        s = state.lower().rstrip("*~#$+")
        for g in groups:
            if g in s:
                groups[g] += count
                break
        else:
            groups["other"] += count
    colors = {
        "allocated": curses.color_pair(1) | curses.A_BOLD, "mixed": curses.color_pair(2) | curses.A_BOLD,
        "idle": curses.color_pair(7), "completing": curses.color_pair(2),
        "drained": curses.color_pair(3), "down": curses.color_pair(3) | curses.A_BOLD,
        "planned": curses.color_pair(6), "other": curses.color_pair(7) | curses.A_DIM,
    }
    col = 2
    s = f"Total: {total}  "
    safe_addstr(win, y, col, s, curses.color_pair(7) | curses.A_BOLD)
    col += len(s)
    for state, count in groups.items():
        if count == 0:
            continue
        s = f"{state}: {count}  "
        if col + len(s) >= width - 1:
            y += 1
            col = 2
        safe_addstr(win, y, col, s, colors[state])
        col += len(s)
    return y + 2


def _table_header(win, y, cols, width):
    hdr = "".join(f" {name:<{w}}" for name, w in cols)
    safe_addstr(win, y, 1, hdr[:width - 2], curses.color_pair(11) | curses.A_BOLD)
    return y + 1


def _scroll_indicator(win, y, start, visible, n):
    if n > visible:
        max_y = win.getmaxyx()[0]
        safe_addstr(win, min(y, max_y - 1), 1, f" [{start + 1}-{min(start + visible, n)}/{n}]",
                    curses.color_pair(7) | curses.A_DIM)


def draw_job_table(win, y, jobs, width, scroll, sort_key, current_user, show_all,
                   filter_user, filter_partition, filter_gpu_type, nodes):
    max_y = win.getmaxyx()[0]
    node_types, partition_types = nodes.get("node_types", {}), nodes.get("partition_types", {})
    filters = []
    if filter_user:
        filters.append(f"user: {filter_user}")
    elif not show_all:
        filters.append("my jobs")
    if filter_partition:
        filters.append(f"partition: {filter_partition}")
    if filter_gpu_type:
        filters.append(f"gpu: {filter_gpu_type}")
    title = "JOBS" + (f" ({', '.join(filters)})" if filters else " (all - press 'm' for mine)")
    safe_addstr(win, y, 1, title, curses.color_pair(4) | curses.A_BOLD)
    safe_addstr(win, y, len(title) + 3, f"[sort: {sort_key}]", curses.color_pair(7) | curses.A_DIM)
    y += 1

    display = jobs
    if filter_user:
        display = [j for j in display if j["user"] == filter_user]
    elif not show_all:
        display = [j for j in display if j["user"] == current_user]
    if filter_partition:
        display = [j for j in display if j["partition"] == filter_partition]
    if filter_gpu_type:
        display = [j for j in display if job_gpu_type(j, node_types, partition_types).lower() == filter_gpu_type.lower()]

    sort_funcs = {
        "id": lambda j: _int(j["id"].split("_")[0]),
        "user": lambda j: j["user"],
        "state": lambda j: (0 if j["state"] == "RUNNING" else 1, j["state"], -j.get("priority", 0)),
        "partition": lambda j: j["partition"],
        "time": lambda j: -(parse_time_to_seconds(j["time"]) or 0),
        "name": lambda j: j["name"],
        "priority": lambda j: -j.get("priority", 0),
    }
    display = sorted(display, key=sort_funcs.get(sort_key, sort_funcs["state"]))

    running = sum(1 for j in display if j["state"] == "RUNNING")
    pending = sum(1 for j in display if j["state"] == "PENDING")
    other = len(display) - running - pending
    summary = f" R:{running} PD:{pending}" + (f" other:{other}" if other else "") + f" total:{len(display)}"
    safe_addstr(win, y, 2, summary, curses.color_pair(7))
    y += 1
    if y >= max_y - 1:
        return y, scroll

    cols = [("JOBID", 10), ("PARTITION", 12), ("NAME", 24), ("USER", 10), ("ST", 4),
            ("TIME", 12), ("LIMIT", 12), ("NODES", 5), ("CPUS", 5), ("GPU", 14), ("REASON/NODELIST", 0)]
    used = sum(c[1] for c in cols[:-1]) + len(cols)
    cols[-1] = (cols[-1][0], max(10, width - used - 2))
    y = _table_header(win, y, cols, width)

    visible = max_y - y - 2
    if visible <= 0:
        return y, scroll
    scroll = min(scroll, max(0, len(display) - visible))
    for j in display[scroll:scroll + visible]:
        if y >= max_y - 1:
            break
        st = {"RUNNING": "R", "PENDING": "PD", "COMPLETING": "CG"}.get(j["state"], j["state"][:2])
        gtype = job_gpu_type(j, node_types, partition_types)
        gres = (f"{gtype}:{job_gpu_count(j)}" if job_gpu_count(j) else gtype) if gtype else ""
        vals = [j["id"], j["partition"], j["name"], j["user"], st, j["time"], j["time_limit"],
                j["nodes"], j["cpus"], gres, j["reason"]]
        row = "".join(f" {v:<{w}}" for v, (_, w) in zip(vals, cols))
        attr = curses.color_pair(1) if j["state"] == "RUNNING" else curses.color_pair(2) if j["state"] == "PENDING" else curses.color_pair(7) | curses.A_DIM
        if j["user"] == current_user:
            attr |= curses.A_BOLD
        safe_addstr(win, y, 1, row[:width - 2], attr)
        y += 1
    _scroll_indicator(win, y, scroll, visible, len(display))
    return y, scroll


def draw_user_table(win, y, user_summary, width, current_user):
    max_y = win.getmaxyx()[0]
    safe_addstr(win, y, 1, "TOP USERS (by GPUs, then running jobs)", curses.color_pair(4) | curses.A_BOLD)
    y += 1
    rows = sorted(user_summary.items(), key=lambda kv: (kv[1]["gpus"], kv[1]["running"]), reverse=True)
    safe_addstr(win, y, 1, f" {'USER':<12} {'RUN':>5} {'PEND':>5} {'CPUs':>7} {'GPUs':>5}"[:width - 2],
                curses.color_pair(11) | curses.A_BOLD)
    y += 1
    for user, s in rows[:max(0, max_y - y - 2)]:
        row = f" {user:<12} {s['running']:>5} {s['pending']:>5} {s['cpus']:>7} {s['gpus']:>5}"
        attr = curses.color_pair(1) | curses.A_BOLD if user == current_user else curses.color_pair(7)
        safe_addstr(win, y, 1, row[:width - 2], attr)
        y += 1
    return y + 1


def draw_my_jobs(win, y, jobs, width, current_user, scroll, nodes, priority_data):
    max_y = win.getmaxyx()[0]
    safe_addstr(win, y, 1, "MY JOBS", curses.color_pair(4) | curses.A_BOLD)
    y += 1
    my_jobs = [j for j in jobs if j["user"] == current_user]
    if not my_jobs:
        safe_addstr(win, y, 2, "No active jobs.", curses.color_pair(7) | curses.A_DIM)
        return y + 2, scroll
    running = sum(j["tasks"] for j in my_jobs if j["state"] == "RUNNING")
    pending = sum(j["tasks"] for j in my_jobs if j["state"] == "PENDING")
    other = sum(j["tasks"] for j in my_jobs) - running - pending
    gpus_run = sum(job_gpu_count(j) for j in my_jobs if j["state"] == "RUNNING")
    summary = f" Running: {running} ({gpus_run} GPUs)  Pending: {pending}" + (f"  Other: {other}" if other else "")
    rank_by_id = {p["id"]: p["rank"] for p in priority_data}
    rank_by_id.update({base_job_id(p["id"]): p["rank"] for p in priority_data if "_" in p["id"]})
    if priority_data and pending:
        best = min((rank_by_id.get(j["id"], rank_by_id.get(base_job_id(j["id"]))) for j in my_jobs
                    if j["state"] == "PENDING" and (j["id"] in rank_by_id or base_job_id(j["id"]) in rank_by_id)), default=None)
        if best:
            summary += f"   best queue rank: {best}/{len(priority_data)}"
    safe_addstr(win, y, 2, summary, curses.color_pair(7))
    y += 1

    cols = [("JOBID", 10), ("NAME", 28), ("ST", 4), ("PARTITION", 10), ("ELAPSED", 12),
            ("LIMIT", 12), ("GPUs", 10), ("RANK", 6), ("ETA/REMAINING", 0)]
    used = sum(c[1] for c in cols[:-1]) + len(cols)
    cols[-1] = (cols[-1][0], max(15, width - used - 2))
    y = _table_header(win, y, cols, width)

    order = {"RUNNING": 0, "PENDING": 1}
    display = sorted(my_jobs, key=lambda j: (order.get(j["state"], 2), -j.get("priority", 0)))
    visible = max_y - y - 2
    if visible <= 0:
        return y, scroll
    scroll = min(scroll, max(0, len(display) - visible))
    for j in display[scroll:scroll + visible]:
        if y >= max_y - 1:
            break
        st = {"RUNNING": "R", "PENDING": "PD", "COMPLETING": "CG"}.get(j["state"], j["state"][:2])
        n = job_gpu_count(j)
        gtype = job_gpu_type(j, nodes.get("node_types", {}), nodes.get("partition_types", {}))
        gpu_str = f"{n} {gtype}"[:10] if n else "-"
        rank = rank_by_id.get(j["id"]) or rank_by_id.get(base_job_id(j["id"]))
        eta, _ = job_eta(j)
        vals = [j["id"], j["name"], st, j["partition"], j["time"], j["time_limit"], gpu_str,
                str(rank) if rank else "-", eta[:cols[-1][1]]]
        row = "".join(f" {v:<{w}}" for v, (_, w) in zip(vals, cols))
        attr = (curses.color_pair(1) if j["state"] == "RUNNING" else curses.color_pair(2)
                if j["state"] == "PENDING" else curses.color_pair(7)) | curses.A_BOLD
        safe_addstr(win, y, 1, row[:width - 2], attr)
        y += 1
    _scroll_indicator(win, y, scroll, visible, len(display))
    return y + 1, scroll


def draw_priority(win, y, priority_data, width, current_user, scroll, mine_only):
    max_y = win.getmaxyx()[0]
    title = "PRIORITY QUEUE" + (" (my jobs - press 'a' for all)" if mine_only else " (all pending - press 'm' for mine)")
    safe_addstr(win, y, 1, title, curses.color_pair(4) | curses.A_BOLD)
    y += 1
    if not priority_data:
        safe_addstr(win, y, 2, "No pending jobs.", curses.color_pair(7) | curses.A_DIM)
        return y + 2, scroll
    mine = [p for p in priority_data if p["user"] == current_user]
    display = mine if mine_only else priority_data
    if not display:
        safe_addstr(win, y, 2, "You have no pending jobs.", curses.color_pair(7) | curses.A_DIM)
        return y + 2, scroll
    w_fs = CLUSTER["w_fairshare"]
    if mine:
        best = min(mine, key=lambda p: p["rank"])
        fs_factor = f", fairshare factor {best['fairshare'] / w_fs:.3f}" if w_fs else ""
        safe_addstr(win, y, 2, f"My best queue rank: {best['rank']}/{len(priority_data)}  (job {best['id']}{fs_factor})",
                    curses.color_pair(1) | curses.A_BOLD)
        y += 1

    cols = [("RANK", 5), ("JOBID", 9), ("USER", 9), ("ACCOUNT", 11), ("PART", 8), ("PRIORITY", 9),
            ("FAIRSHARE", 9), ("QOS", 8), ("PART", 7), ("SIZE", 6), ("AGE", 7), ("NICE", 5),
            ("COMPOSITION (F=fairshare Q=qos P=partition S=size A=age)", 0)]
    used = sum(c[1] for c in cols[:-1]) + len(cols)
    cols[-1] = (cols[-1][0], max(15, width - used - 2))
    y = _table_header(win, y, cols, width)

    visible = max_y - y - 4
    if visible <= 0:
        return y, scroll
    scroll = min(scroll, max(0, len(display) - visible))
    scale = max(p["priority"] for p in priority_data) or 1
    for p in display[scroll:scroll + visible]:
        if y >= max_y - 3:
            break
        vals = [str(p["rank"]), p["id"], p["user"][:9], p["account"][:11], p["partition_name"][:8],
                str(p["priority"]), str(p["fairshare"]), str(p["qos"]), str(p["partition"]),
                str(p["jobsize"]), str(p["age"]), str(p["nice"])]
        row = "".join(f" {v:<{w}}" for v, (_, w) in zip(vals, cols[:-1]))
        is_me = p["user"] == current_user
        safe_addstr(win, y, 1, row[:width - 2], curses.color_pair(1) | curses.A_BOLD if is_me else curses.color_pair(7))
        bar_x = len(row) + 2
        bar_w = min(cols[-1][1], width - bar_x - 3)
        if bar_w > 8:
            inner = bar_w - 2
            safe_addstr(win, y, bar_x, "[", curses.color_pair(7))
            x = bar_x + 1
            for ch_, val, cp in (("F", p["fairshare"], 1), ("Q", p["qos"], 6), ("P", p["partition"], 4),
                                 ("S", p["jobsize"], 7), ("A", p["age"], 2)):
                n = int(inner * max(0, val) / scale)
                if n > 0 and x + n <= bar_x + bar_w - 1:
                    safe_addstr(win, y, x, ch_ * n, curses.color_pair(cp) | curses.A_BOLD)
                    x += n
            safe_addstr(win, y, bar_x + bar_w - 1, "]", curses.color_pair(7))
        y += 1
    y += 1
    if y < max_y - 1:
        safe_addstr(win, y, 2, (priority_summary_line() + "  |  bar scaled to top of queue")[:width - 3],
                    curses.color_pair(7) | curses.A_DIM)
        y += 1
    _scroll_indicator(win, y, scroll, visible, len(display))
    return y + 1, scroll


def draw_fairshare(win, y, tree, width, current_user):
    max_y = win.getmaxyx()[0]
    safe_addstr(win, y, 1, "FAIRSHARE (fair tree: account level, then user level)", curses.color_pair(4) | curses.A_BOLD)
    y += 1
    if not tree or not tree.get("my_accounts"):
        safe_addstr(win, y, 2, "No fairshare data available (loading or no association).", curses.color_pair(7) | curses.A_DIM)
        return y + 2
    bar_width = max(10, min(40, width - 50))
    for s in fairshare_summary(tree, current_user):
        if y >= max_y - 10:
            break
        me, acct = s["me"], s["account_row"]
        fs_val = me["fairshare"]
        fs_color, fs_label = (3, "LOW") if fs_val < 0.3 else (2, "MED") if fs_val < 0.6 else (1, "HIGH")
        safe_addstr(win, y, 2, f"{current_user} @ {s['account']}", curses.color_pair(4) | curses.A_BOLD)
        y += 1
        safe_addstr(win, y, 4, f"FairShare: {fs_val:.4f}", curses.color_pair(7))
        draw_colored_bar(win, y, 26, bar_width, fs_val, fs_color)
        extra = f" {fs_label}" + (f"  -> +{s['priority_contribution']:,} priority" if CLUSTER["w_fairshare"] else "")
        safe_addstr(win, y, 27 + bar_width, extra, curses.color_pair(fs_color) | curses.A_BOLD)
        y += 2

        if acct:
            safe_addstr(win, y, 4, f"Level 1  {s['account']} among {s['n_accounts']} accounts",
                        curses.color_pair(6) | curses.A_BOLD)
            y += 1
            ratio = s["account_usage_vs_share"] or 0
            c = 1 if ratio < 0.8 else 2 if ratio < 1.2 else 3
            safe_addstr(win, y, 6,
                        f"rank {acct['rank']}/{s['n_accounts']}   LevelFS {fmt_lfs(acct['level_fs'])}   "
                        f"share {acct['norm_shares'] * 100:.1f}% of cluster, using {acct['norm_usage'] * 100:.1f}%",
                        curses.color_pair(7))
            y += 1
            t = acct["tres_run_mins"]
            per_type = ", ".join(f"{k} {v}" for k, v in t.items() if k not in ("cpu", "gpu") and v)
            safe_addstr(win, y, 6, f"GPU-minutes reserved by account's running jobs: {t.get('gpu', 0)}"
                        + (f" ({per_type})" if per_type else ""), curses.color_pair(7) | curses.A_DIM)
            y += 1
            msg = ("account under-using its share -> good for everyone in it" if ratio < 0.8 else
                   "account near its share" if ratio < 1.2 else
                   "account over-using its share -> whole group ranks lower")
            safe_addstr(win, y, 6, msg, curses.color_pair(c))
            y += 2

        safe_addstr(win, y, 4, f"Level 2  {current_user} among {s['n_members']} members of {s['account']}",
                    curses.color_pair(6) | curses.A_BOLD)
        y += 1
        c = 1 if s["my_share_of_account"] <= s["fair_share_of_account"] else 2 if s["my_share_of_account"] <= 2 * s["fair_share_of_account"] else 3
        safe_addstr(win, y, 6,
                    f"rank {me.get('rank', '?')}/{s['n_members']}   LevelFS {fmt_lfs(me['level_fs'])}   "
                    f"my usage {format_usage(me['raw_usage'])} = {s['my_share_of_account'] * 100:.1f}% of account "
                    f"(equal share {s['fair_share_of_account'] * 100:.1f}%)", curses.color_pair(c))
        y += 1
        if s["heaviest_member"]:
            hm = s["heaviest_member"]
            who = "you" if hm["user"] == current_user else hm["user"]
            safe_addstr(win, y, 6, f"{s['n_active_members']} active member(s); heaviest: {who} at {hm['share'] * 100:.0f}% of account usage",
                        curses.color_pair(7) | curses.A_DIM)
            y += 1
        if s["hours_to_fair_me"] is not None:
            def _ttf(h):
                return "already fair" if h == 0 else "~{:.1f}h idle".format(h)
            parts = ["you: " + _ttf(s["hours_to_fair_me"])]
            if s["hours_to_fair_account"] is not None:
                parts.append("account: " + _ttf(s["hours_to_fair_account"]))
            safe_addstr(win, y, 6, "Time to LevelFS=1 (optimistic): " + "   ".join(parts), curses.color_pair(6))
            y += 1
        y += 1

    if y < max_y - 2:
        hl = CLUSTER["half_life_s"]
        decay = (f"Usage decays with {seconds_to_human(hl)} half-life." if hl else
                 f"Usage reset: {CLUSTER['usage_reset']}." if CLUSTER["usage_reset"] not in ("", "NONE") else
                 "Usage never decays or resets on this cluster.")
        safe_addstr(win, y, 2, f"{decay} Running jobs count immediately. GPU-minutes are billed per type.",
                    curses.color_pair(7) | curses.A_DIM)
        y += 1
    return y


def draw_leaderboard(win, y, tree, width, current_user, scroll, level, acct_idx, show_idle):
    """level='acct': all accounts. level='user': members of one of my accounts."""
    max_y = win.getmaxyx()[0]
    if not tree or not tree.get("accounts"):
        safe_addstr(win, y, 1, "LEADERBOARD", curses.color_pair(4) | curses.A_BOLD)
        safe_addstr(win, y + 1, 2, "No data available (loading).", curses.color_pair(7) | curses.A_DIM)
        return y + 3, scroll
    my_accts = [m["account"] for m in tree["my_accounts"]] or [""]
    my_acct = my_accts[acct_idx % len(my_accts)]
    if level == "acct":
        rows = [r for r in tree["accounts"] if r["raw_shares"] > 0 or r["raw_usage"] > 0]
        title = f"ACCOUNTS (fair-tree level 1, sorted by LevelFS; mine = {', '.join(a for a in my_accts if a)})"
        name_key = "account"
        is_mine = lambda r: r["account"] in my_accts
    else:
        rows = tree["users"].get(my_acct, [])
        if not show_idle:
            rows = [r for r in rows if r["raw_usage"] > 0 or r["user"] == current_user]
        title = f"MEMBERS OF {my_acct} (fair-tree level 2, sorted by LevelFS)"
        name_key = "user"
        is_mine = lambda r: r["user"] == current_user
    safe_addstr(win, y, 1, title[:width - 2], curses.color_pair(4) | curses.A_BOLD)
    y += 1
    hint = "l: accounts/members" + ("  t: next account" if len(my_accts) > 1 else "") + \
           (f"  i: {'hide' if show_idle else 'show'} idle" if level == "user" else "")
    safe_addstr(win, y, 2, hint, curses.color_pair(7) | curses.A_DIM)
    y += 1
    if not rows:
        safe_addstr(win, y, 2, "No entries.", curses.color_pair(7) | curses.A_DIM)
        return y + 2, scroll

    total_usage = sum(r["raw_usage"] for r in rows) or 1
    max_usage = max(r["raw_usage"] for r in rows) or 1
    root_tres = (tree.get("root") or {}).get("tres_run_mins", {})
    gpu_types = sorted((k for k, v in root_tres.items() if k not in ("cpu", "gpu") and v), key=lambda k: -root_tres[k])[:3]
    bar_width = max(5, min(25, width - 90 - 7 * len(gpu_types)))
    hdr = f" {'#':>3} {'NAME':<12} {'SHARE%':>7} {'USAGE%':>7} {'RAWUSAGE':>9} {'LEVELFS':>8} {'GPU-MIN':>8}"
    hdr += "".join(f" {t[:6].upper():>6}" for t in gpu_types) + f" {'FAIRSHARE':>9}  USAGE"
    safe_addstr(win, y, 1, hdr[:width - 2], curses.color_pair(11) | curses.A_BOLD)
    y += 1
    visible = max_y - y - 2
    if visible <= 0:
        return y, scroll
    scroll = min(scroll, max(0, len(rows) - visible))
    for idx in range(scroll, min(scroll + visible, len(rows))):
        if y >= max_y - 1:
            break
        r = rows[idx]
        t = r["tres_run_mins"]
        fs = f"{r['fairshare']:.4f}" if r["fairshare"] else "-"
        row = (f" {r.get('rank', idx + 1):>3} {r[name_key][:12]:<12} {r['norm_shares'] * 100:>6.1f}% "
               f"{r['raw_usage'] / total_usage * 100:>6.1f}% {format_usage(r['raw_usage']):>9} "
               f"{fmt_lfs(r['level_fs']):>8} {t.get('gpu', 0):>8}")
        row += "".join(f" {t.get(g, 0):>6}" for g in gpu_types) + f" {fs:>9}  "
        me = is_mine(r)
        safe_addstr(win, y, 1, row[:width - 2], curses.color_pair(1) | curses.A_BOLD if me else curses.color_pair(7))
        bar_x = len(row) + 1
        if bar_x + bar_width < width - 3:
            draw_colored_bar(win, y, bar_x, bar_width, r["raw_usage"] / max_usage, 1 if me else 4)
            if me and bar_x + bar_width + 3 < width:
                safe_addstr(win, y, bar_x + bar_width + 1, "<<", curses.color_pair(1) | curses.A_BOLD)
        y += 1
    _scroll_indicator(win, y, scroll, visible, len(rows))
    return y + 1, scroll


def draw_history(win, y, history, width, scroll):
    max_y = win.getmaxyx()[0]
    safe_addstr(win, y, 1, "RECENT HISTORY (last 7 days)", curses.color_pair(4) | curses.A_BOLD)
    y += 1
    if not history:
        safe_addstr(win, y, 2, "No recent jobs found.", curses.color_pair(7) | curses.A_DIM)
        return y + 2, scroll
    cols = [("JOBID", 10), ("NAME", 32), ("STATE", 12), ("EXIT", 6), ("ELAPSED", 12),
            ("PARTITION", 12), ("GPUs", 10), ("END", 19)]
    y = _table_header(win, y, cols, width)
    visible = max_y - y - 2
    if visible <= 0:
        return y, scroll
    display = list(reversed(history))  # most recent first
    scroll = min(scroll, max(0, len(display) - visible))
    for j in display[scroll:scroll + visible]:
        if y >= max_y - 1:
            break
        gpu_str = (f"{j['gpus']} {j['gpu_type']}".strip() if j["gpus"] else "-")[:10]
        vals = [j["id"], j["name"], j["state"], j["exit_code"], j["elapsed"], j["partition"], gpu_str, j.get("end", "")]
        row = "".join(f" {v:<{w}}" for v, (_, w) in zip(vals, cols))
        st = j["state"]
        attr = (curses.color_pair(1) if st in ("COMPLETED", "RUNNING") else
                curses.color_pair(3) | curses.A_BOLD if st in ("TIMEOUT", "FAILED", "NODE_FAIL", "OUT_OF_MEMORY") else
                curses.color_pair(2) if st.startswith("CANCELLED") else curses.color_pair(7))
        safe_addstr(win, y, 1, row[:width - 2], attr)
        y += 1
    _scroll_indicator(win, y, scroll, visible, len(display))
    return y + 1, scroll


def draw_footer(win, height, width, view_mode):
    views = "1:Main 2:MyJobs 3:Priority 4:FairShare 5:Leaderboard 6:History u:Users"
    keys = f" {views} | q:Quit r:Refresh s:Sort /:User p:Part g:GPU a/m:All/My +/-:Intv"
    if view_mode == "leaderboard":
        keys += " l:Level t:Acct i:Idle"
    safe_addstr(win, height - 1, 0, " " * (width - 1), curses.color_pair(5))
    safe_addstr(win, height - 1, 1, keys[:width - 2], curses.color_pair(5))


def prompt_input(stdscr, height, width, prompt):
    curses.curs_set(1)
    stdscr.nodelay(False)
    try:
        safe_addstr(stdscr, height - 1, 0, " " * (width - 1), curses.color_pair(5))
        safe_addstr(stdscr, height - 1, 1, prompt[:width - 2], curses.color_pair(5))
        stdscr.refresh()
        curses.echo()
        inp = stdscr.getstr(height - 1, min(len(prompt) + 1, width - 2), 30).decode("utf-8", "ignore").strip()
        curses.noecho()
    except curses.error:
        inp = ""
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(300)
    return inp


VIEW_NAMES = {"main": "Main", "users": "Users", "my_jobs": "My Jobs", "priority": "Priority",
              "fairshare": "FairShare", "leaderboard": "Leaderboard", "history": "History"}


def main(stdscr, current_user):
    global REFRESH_INTERVAL
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(300)
    init_colors()

    scroll = 0
    sort_keys = ["state", "priority", "id", "user", "partition", "time", "name"]
    sort_idx = 0
    show_all = True
    filter_user = filter_partition = filter_gpu_type = ""
    view_mode = "main"
    lb_level, lb_acct_idx, lb_show_idle = "acct", 0, False

    partitions, nodes, jobs, user_summary = {}, {}, [], {}
    priority_data, fs_tree, history = [], {}, []
    usable_types = None
    if PROFILE.get("account_gpu_types"):
        fs_tree = get_sshare_tree(current_user)
    last_fetch = last_slow_fetch = 0
    fetched_slow = set()

    while True:
        now = time.time()
        if now - last_fetch >= REFRESH_INTERVAL:
            partitions, nodes, jobs = fetch_fast()
            annotate_partitions(partitions, nodes)
            user_summary = get_user_summary(jobs)
            if PROFILE.get("account_gpu_types") and fs_tree:
                usable_types = usable_gpu_types(nodes["gpu_by_type"], [m["account"] for m in fs_tree["my_accounts"]])
            last_fetch = now
        if now - last_slow_fetch >= SLOW_INTERVAL or view_mode not in fetched_slow:
            if view_mode in ("priority", "my_jobs"):
                priority_data = get_priority_data(jobs)
            if view_mode in ("fairshare", "leaderboard"):
                fs_tree = get_sshare_tree(current_user)
            if view_mode == "history":
                history = get_recent_history(current_user)
            fetched_slow.add(view_mode)
            last_slow_fetch = now

        stdscr.erase()
        height, width = stdscr.getmaxyx()
        if height < 10 or width < 40:
            safe_addstr(stdscr, 0, 0, "Terminal too small. Resize to at least 40x10.")
            stdscr.refresh()
            time.sleep(0.5)
            continue

        y = draw_header(stdscr, 0, width, current_user, VIEW_NAMES.get(view_mode, ""))
        if view_mode == "main":
            y = draw_partition_bars(stdscr, y, partitions, nodes, width, usable_types)
            y = draw_node_summary(stdscr, y, nodes.get("node_states", {}), width)
            y, scroll = draw_job_table(stdscr, y, jobs, width, scroll, sort_keys[sort_idx], current_user,
                                       show_all, filter_user, filter_partition, filter_gpu_type, nodes)
        elif view_mode == "users":
            y = draw_partition_bars(stdscr, y, partitions, nodes, width, usable_types)
            y = draw_node_summary(stdscr, y, nodes.get("node_states", {}), width)
            y = draw_user_table(stdscr, y, user_summary, width, current_user)
        elif view_mode == "my_jobs":
            y, scroll = draw_my_jobs(stdscr, y, jobs, width, current_user, scroll, nodes, priority_data)
        elif view_mode == "priority":
            y, scroll = draw_priority(stdscr, y, priority_data, width, current_user, scroll, not show_all)
        elif view_mode == "fairshare":
            y = draw_fairshare(stdscr, y, fs_tree, width, current_user)
        elif view_mode == "leaderboard":
            y, scroll = draw_leaderboard(stdscr, y, fs_tree, width, current_user, scroll,
                                         lb_level, lb_acct_idx, lb_show_idle)
        elif view_mode == "history":
            y, scroll = draw_history(stdscr, y, history, width, scroll)
        draw_footer(stdscr, height, width, view_mode)
        stdscr.refresh()

        try:
            ch = stdscr.getch()
        except curses.error:
            ch = -1
        if ch == -1:
            continue
        c = chr(ch).lower() if 0 <= ch < 256 else ""

        def switch(view):
            nonlocal view_mode, scroll
            view_mode, scroll = view, 0

        if c == 'q':
            break
        elif c == 'r':
            last_fetch = last_slow_fetch = 0
        elif c == '1':
            switch("main")
        elif c == '2':
            switch("my_jobs")
        elif c == '3':
            switch("priority")
        elif c == '4':
            switch("fairshare")
        elif c == '5':
            switch("leaderboard")
        elif c == '6':
            switch("history")
        elif c == 'u':
            switch("users" if view_mode != "users" else "main")
        elif c == 'a':
            show_all, filter_user, scroll = True, "", 0
        elif c == 'm':
            show_all, filter_user, scroll = False, "", 0
        elif c == 's':
            sort_idx = (sort_idx + 1) % len(sort_keys)
            scroll = 0
        elif c == 'l':
            lb_level, scroll = ("user" if lb_level == "acct" else "acct"), 0
        elif c == 't':
            lb_acct_idx, scroll = lb_acct_idx + 1, 0
        elif c == 'i':
            lb_show_idle, scroll = not lb_show_idle, 0
        elif c == '/':
            inp = prompt_input(stdscr, height, width, "Filter user: ")
            filter_user = inp
            if inp:
                show_all = True
            scroll = 0
        elif c == 'p':
            avail = ", ".join(sorted(partitions)) if partitions else ""
            inp = prompt_input(stdscr, height, width, f"Partition [{avail}]: ")
            filter_partition = inp if inp in partitions else ""
            scroll = 0
        elif c == 'g':
            avail = ", ".join(sorted(nodes.get("gpu_by_type", {}))) if nodes else ""
            filter_gpu_type = prompt_input(stdscr, height, width, f"GPU type [{avail}]: ")
            scroll = 0
        elif ch == curses.KEY_UP:
            scroll = max(0, scroll - 1)
        elif ch == curses.KEY_DOWN:
            scroll += 1
        elif ch == curses.KEY_PPAGE:
            scroll = max(0, scroll - 20)
        elif ch == curses.KEY_NPAGE:
            scroll += 20
        elif ch == curses.KEY_HOME:
            scroll = 0
        elif c in ('+', '='):
            REFRESH_INTERVAL = min(30, REFRESH_INTERVAL + 1)
        elif c in ('-', '_'):
            REFRESH_INTERVAL = max(1, REFRESH_INTERVAL - 1)


# ── Entry point ──────────────────────────────────────────────────────────────

def parse_args():
    ap = argparse.ArgumentParser(prog="slurm-top", description="htop-like Slurm dashboard; --json for a one-shot snapshot.")
    ap.add_argument("--json", action="store_true", help="print a JSON snapshot and exit (no TUI)")
    ap.add_argument("--compact", action="store_true", help="with --json: single-line output")
    ap.add_argument("-u", "--user", default=None, help="user to report on (default: $USER)")
    ap.add_argument("--days", type=int, default=7, help="history window in days (default 7)")
    ap.add_argument("-i", "--interval", type=int, default=None, help="TUI refresh interval in seconds")
    return ap.parse_args()


if __name__ == "__main__":
    args = parse_args()
    current_user = args.user or os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"
    load_cluster_config()
    if args.interval:
        REFRESH_INTERVAL = max(1, args.interval)
    if args.json:
        snap = collect_snapshot(current_user, history_days=args.days)
        if args.compact:
            print(json.dumps(snap, separators=(",", ":"), default=str))
        else:
            print(json.dumps(snap, indent=2, default=str))
        sys.exit(0)
    signal.signal(signal.SIGWINCH, lambda *a: None)
    try:
        curses.wrapper(main, current_user)
    except KeyboardInterrupt:
        pass
